# Copy to .env (gitignored) on the Containerlab host before deploy/verify.
#   cp .env.example .env
#
# LAB-ONLY values. Not production secrets. The future kagent MCP will
# read eAPI credentials from Vault (path name only: secret/platform/arista-ceos).
# Never commit .env. Never paste these values into chat or screenshots.

# Docker Hub tags on sebbycorp/ceosimage (inspected 2026-08-18):
#   latest     — default (arm64)
#   4.33.4M    — newer published tag (also arm64)
# Override here, or export CEOS_IMAGE, or edit clab/topology.yml
# kinds.arista_ceos.image. This repo does not store or republish the image.
CEOS_IMAGE=sebbycorp/ceosimage:latest

# Containerlab/cEOS default AAA. Required because a custom startup-config
# replaces the kind's generated admin/admin user. Generate locally only.
CEOS_LAB_USER=admin
CEOS_LAB_PASSWORD=admin
