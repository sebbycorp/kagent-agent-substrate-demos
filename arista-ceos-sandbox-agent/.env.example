# Copy to .env (gitignored) on Viper before deploy/verify.
#   cp .env.example .env
#
# LAB-ONLY values. Not production secrets. The future kagent MCP will
# read eAPI credentials from Vault path secret/platform/arista-ceos
# keys: username, password, hosts_json (not host).
# Never commit .env. Never paste these values into chat or screenshots.

# Local Docker image only (linux/amd64). Official import on Viper:
#   docker import cEOS64-lab-4.33.9M.tar.xz ceos:4.33.9M
# Do NOT docker pull. Do not use a Hub image. This repo does not store
# or republish the tarball. Override here, export CEOS_IMAGE, or edit
# clab/topology.yml kinds.arista_ceos.image (local name only).
CEOS_IMAGE=ceos:4.33.9M

# Containerlab/cEOS default AAA. Required because a custom startup-config
# replaces the kind's generated admin/admin user. Generate locally only.
CEOS_LAB_USER=admin
CEOS_LAB_PASSWORD=admin
